(version 1)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.1524mm))
)
(rule "Minimum text height and thickness 1"
	(constraint text_height (min 0.75mm))
	(constraint text_thickness (min 0.1mm))
)
(rule "Minimum connection width 1"
	(constraint connection_width (min 0.1524mm))
)
(rule "Minimum annular width 1"
	(constraint annular_width (min 0.127mm))
)
(rule "Via style 1"
	(constraint via_diameter (min 0.45mm) (max 2.5mm))
	(constraint hole_size (min 0.3mm) (max 2mm))
)
